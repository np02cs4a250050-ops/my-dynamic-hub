# Public Supabase configuration (safe to expose in the browser).
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase secret. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Cloudflare Turnstile protection for enquiry forms.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional email notification for new enquiries (Resend).
RESEND_API_KEY=""
ENQUIRY_NOTIFICATION_TO="studio@example.com"
ENQUIRY_NOTIFICATION_FROM="KRITI'S KIRTI <website@example.com>"

# Salt used to hash visitor IPs for enquiry rate limiting.
ENQUIRY_RATE_LIMIT_SALT=""
